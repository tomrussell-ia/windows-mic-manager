<UserControl
    x:Class="MicrophoneManager.WinUI.Views.MicrophoneFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicrophoneManager.WinUI.Views"
    xmlns:viewmodels="using:MicrophoneManager.WinUI.ViewModels"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid x:Name="RootGrid" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Error Banner -->
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/> <!-- Microphone List -->
            <RowDefinition Height="Auto"/> <!-- Empty State -->
        </Grid.RowDefinitions>

        <!-- Error Banner (auto-dismisses after 5 seconds) -->
        <InfoBar Grid.Row="0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="True"
                 Margin="1,0,1,3"
                 CloseButtonClick="ErrorInfoBar_CloseButtonClick"
                 AutomationProperties.AutomationId="ErrorInfoBar"/>

        <!-- Header with Dock/Undock button -->
        <Grid x:Name="HeaderRow" Grid.Row="1" Margin="1,0,1,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                      Text="Microphones"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      VerticalAlignment="Center"/>

            <!-- Dock / Undock button -->
            <Button Grid.Column="1"
                    x:Name="DockButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="2"
                    Click="DockButton_Click"
                    ToolTipService.ToolTip="Dock / Undock"
                    AutomationProperties.AutomationId="DockButton"
                    AutomationProperties.Name="Dock or undock microphone manager">
                <FontIcon x:Name="DockIcon"
                         Glyph="&#xE718;"
                         FontSize="14"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Button>
        </Grid>

        <!-- Microphone List -->
        <ScrollViewer x:Name="MicrophoneScroll"
                 Grid.Row="2"
                 VerticalScrollBarVisibility="Disabled"
                 HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MicrophoneList"
                         ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                         Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MicrophoneEntryViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               CornerRadius="6"
                               Width="116"
                               VerticalAlignment="Top"
                               Padding="6"
                               Margin="3,0,0,0"
                               Loaded="MicrophoneCard_Loaded"
                               SizeChanged="MicrophoneCard_SizeChanged">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Device identity (icon + name + fidelity badge) -->
                                    <RowDefinition Height="16"/>   <!-- Comms warning (fixed-height so all cards align) -->
                                    <RowDefinition Height="Auto"/> <!-- dB readout -->
                                    <RowDefinition Height="140"/>  <!-- Meter + Slider -->
                                    <RowDefinition Height="Auto"/> <!-- Icon action row -->
                                </Grid.RowDefinitions>

                                <!-- Device identity (truncated, full info on tooltip hover) -->
                                <Grid Grid.Row="0"
                                      ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                             Glyph="&#xE720;"
                                             FontSize="12"
                                             Margin="0,0,3,0"
                                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                              Text="{x:Bind Name, Mode=OneWay}"
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              TextTrimming="CharacterEllipsis"
                                              TextWrapping="NoWrap"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center"/>
                                    <Border Grid.Column="2"
                                            CornerRadius="3" Padding="3,1"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind FormatTag, Mode=OneWay}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind FidelityColor, Mode=OneWay}"/>
                                        </Border.Background>
                                        <TextBlock Text="{x:Bind FidelityLabel, Mode=OneWay}"
                                                  FontSize="9"
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Communications warning (fixed-height row so all cards align; opacity hides it when inactive) -->
                                <Border Grid.Row="1"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="3"
                                        Padding="4,0"
                                        VerticalAlignment="Stretch"
                                        Opacity="{x:Bind local:BindingFunctions.ToOpacity(IsDefaultCommunication), Mode=OneWay}"
                                        ToolTipService.ToolTip="Communications processing active — apps like Teams and Zoom apply noise suppression and AGC to this mic.">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;"
                                                 FontSize="9"
                                                 Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Comms"
                                                  FontSize="9"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- dB readout (prominent, OBS-style) -->
                                <TextBlock Grid.Row="2"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center"
                                          ToolTipService.ToolTip="Input level (dBFS)">
                                    <Run Text="{x:Bind local:BindingFunctions.DbText(InputLevelDbFs), Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Meter + Slider (core mixer strip) -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          x:Name="MeterHost"
                                          Margin="0,0,4,0"
                                          Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                          Loaded="MeterHost_Loaded"
                                          Unloaded="MeterHost_Unloaded"
                                          SizeChanged="MeterHost_SizeChanged">
                                        <Canvas>
                                            <Rectangle x:Name="ZoneGreen"
                                                       Fill="{StaticResource MeterGreenBrush}"
                                                       Opacity="0.25"
                                                       IsHitTestVisible="False"/>
                                            <Rectangle x:Name="ZoneYellow"
                                                       Fill="{StaticResource MeterYellowBrush}"
                                                       Opacity="0.25"
                                                       IsHitTestVisible="False"/>
                                            <Rectangle x:Name="ZoneRed"
                                                       Fill="{StaticResource MeterRedBrush}"
                                                       Opacity="0.25"
                                                       IsHitTestVisible="False"/>
                                            <Rectangle x:Name="MeterFill"
                                                       Fill="{x:Bind local:BindingFunctions.MeterBrush(InputLevelDbFs), Mode=OneWay}"/>
                                            <Canvas x:Name="TickCanvas"
                                                    IsHitTestVisible="False"/>
                                            <Rectangle x:Name="PeakMarker"
                                                       Height="2"
                                                       Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Canvas>
                                    </Grid>

                                    <Slider Grid.Column="1"
                                           Orientation="Vertical"
                                           Minimum="0"
                                           Maximum="100"
                                           ToolTipService.ToolTip="Volume"
                                           AutomationProperties.AutomationId="{x:Bind VolumeSliderAutomationId, Mode=OneWay}"
                                         AutomationProperties.Name="Microphone volume"
                                           Value="{x:Bind VolumePercent, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Icon action row: mute, set default, set communications -->
                                <Grid Grid.Row="4" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0" Tag="default" Click="ModeToggle_Click"
                                           IsChecked="{x:Bind IsDefault, Mode=OneWay}"
                                           Command="{x:Bind SetDefaultCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="28" Padding="0"
                                           ToolTipService.ToolTip="Set as default device (apps, games, system sounds)"
                                           AutomationProperties.AutomationId="{x:Bind SetDefaultAutomationId, Mode=OneWay}"
                                         AutomationProperties.Name="Set as default microphone">
                                        <FontIcon Glyph="&#xE7F4;"
                                                 FontSize="13"/>
                                    </ToggleButton>

                                    <ToggleButton Grid.Column="1" Tag="comm" Click="ModeToggle_Click"
                                           IsChecked="{x:Bind IsDefaultCommunication, Mode=OneWay}"
                                           Command="{x:Bind SetDefaultCommunicationCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="28" Padding="0"
                                           ToolTipService.ToolTip="Set as default communications device (Teams, Zoom, Discord)"
                                           AutomationProperties.AutomationId="{x:Bind SetDefaultCommunicationAutomationId, Mode=OneWay}"
                                         AutomationProperties.Name="Set as default communications microphone">
                                        <FontIcon Glyph="&#xE717;"
                                                 FontSize="13"/>
                                    </ToggleButton>

                                    <Button Grid.Column="2"
                                           Command="{x:Bind ToggleMuteCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="28" Padding="0"
                                           ToolTipService.ToolTip="{x:Bind local:BindingFunctions.MuteLabel(IsMuted), Mode=OneWay}"
                                           AutomationProperties.AutomationId="{x:Bind ToggleMuteAutomationId, Mode=OneWay}"
                                         AutomationProperties.Name="Toggle microphone mute">
                                        <FontIcon Glyph="{x:Bind local:BindingFunctions.MuteGlyph(IsMuted), Mode=OneWay}"
                                                 FontSize="13"
                                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- No microphones message -->
        <TextBlock x:Name="EmptyStateText" Grid.Row="3"
                  Text="No microphones detected"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="2,4,0,0"
                  Visibility="{x:Bind ViewModel.HasNoMicrophones, Mode=OneWay}"/>
    </Grid>
</UserControl>
